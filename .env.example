# shrl-io environment template
#
# Copy to .env and adjust for your instance:
#   cp .env.example .env
#
# How this file is consumed:
#   - Compose (primary): docker/podman compose auto-reads the root .env to
#     fill the ${VAR:-default} placeholders in dev.compose.yaml, so a copy
#     with no edits already runs:  podman compose -f dev.compose.yaml up
#   - Standalone Go runs: Go never loads .env itself. Source it first:
#       set -a; source .env; set +a
#     then `go run ./api` (also ./worker, ./auth, ./redirector)
#   - Frontend: `npm run dev` loads .env; production `node build` reads
#     process env, so export the variables rather than relying on .env
#
# Sections mirror the README "Configuration" tables, one per service.
# Shared variables (Postgres, Redis, retention) are repeated per section so
# each is self-contained. Commented lines are optional tuning knobs or
# per-instance secrets; see the README for defaults and meaning.

# --- Redirector ---
# Redis-only public server that 302s visitors to their Destination (ADR 0001).
SHRL_REDIRECTOR_ADDR=:8080
SHRL_REDIRECTOR_RATE_LIMIT_IP=600
SHRL_REDIRECTOR_RATE_LIMIT_LINK=3000
SHRL_REDIS_ADDR=localhost:6379
# SHRL_REDIS_POOL_SIZE=50
# SHRL_REDIS_MIN_IDLE_CONNS=5

# --- Worker ---
# Analytics aggregator: batch-upserts the Redis visit stream into Postgres.
SHRL_DATABASE_URL=postgres://shrl:shrl@localhost:5432/shrl
SHRL_REDIS_ADDR=localhost:6379
SHRL_RETENTION_DAYS=365
# Optional: enables country/region/city analytics (MaxMind GeoLite2).
# SHRL_GEOLITE_LICENSE=
# SHRL_GEOLITE_DB_PATH=/data/GeoLite2-City.mmdb
# SHRL_DB_MAX_OPEN_CONNS=20
# SHRL_DB_MAX_IDLE_CONNS=5
# SHRL_DB_CONN_MAX_LIFETIME=30m
# SHRL_DB_CONN_MAX_IDLE_TIME=5m
# SHRL_REDIS_POOL_SIZE=0
# SHRL_REDIS_MIN_IDLE_CONNS=2

# --- Internal API ---
# Serves the UI; reachable only by the frontend, which proxies requests on
# the signed-in user's behalf with the session token (ADR 0015).
SHRL_API_ADDR=:8080
SHRL_API_INTERNAL_SECRET=dev-internal-secret
SHRL_ADMIN_USERNAME=admin
SHRL_DEFAULT_HOSTNAME=localhost
SHRL_DATABASE_URL=postgres://shrl:shrl@localhost:5432/shrl
SHRL_REDIS_ADDR=localhost:6379
SHRL_RETENTION_DAYS=365
# First-run admin password: random and shown once unless set (bcrypt-hashed).
# SHRL_ADMIN_PASSWORD=
# SHRL_TOKEN_TTL=86400
# SHRL_CODE_LENGTH=6
# SHRL_DB_MAX_OPEN_CONNS=20
# SHRL_DB_MAX_IDLE_CONNS=5
# SHRL_DB_CONN_MAX_LIFETIME=30m
# SHRL_DB_CONN_MAX_IDLE_TIME=5m
# SHRL_REDIS_POOL_SIZE=0
# SHRL_REDIS_MIN_IDLE_CONNS=2

# --- Auth API ---
# Public /v1 API for scripts and CI, authenticated by an API key (ADR 0016).
SHRL_AUTH_ADDR=:8080
SHRL_AUTH_RATE_LIMIT_IP=60
SHRL_AUTH_RATE_LIMIT_KEY_READ=300
SHRL_AUTH_RATE_LIMIT_KEY_WRITE=30
SHRL_AUTH_RATE_LIMIT_FAIL=10
SHRL_DEFAULT_HOSTNAME=localhost
SHRL_DATABASE_URL=postgres://shrl:shrl@localhost:5432/shrl
SHRL_REDIS_ADDR=localhost:6379
SHRL_RETENTION_DAYS=365
# SHRL_DB_MAX_OPEN_CONNS=20
# SHRL_DB_MAX_IDLE_CONNS=5
# SHRL_DB_CONN_MAX_LIFETIME=30m
# SHRL_DB_CONN_MAX_IDLE_TIME=5m
# SHRL_REDIS_POOL_SIZE=0
# SHRL_REDIS_MIN_IDLE_CONNS=2

# --- Frontend ---
# SvelteKit admin UI; signs users in with an HttpOnly session cookie (ADR 0005).
SHRL_API_URL=http://localhost:8080
SHRL_API_INTERNAL_SECRET=dev-internal-secret
SHRL_DEFAULT_HOSTNAME=localhost
SHRL_COOKIE_SECURE=false
# Session cookie HMAC secret: random per boot unless set.
# SHRL_SESSION_SECRET=
# SHRL_SESSION_TTL=86400
